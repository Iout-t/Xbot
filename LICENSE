 ## 23. ProGuard Rules

### `app/proguard-rules.pro`
```proguard
# Hilt
-keep class dagger.hilt.** { *; }
-keep class com.example.automation.di.** { *; }

# Room
-keep class com.example.automation.data.local.** { *; }
-keep @androidx.room.Entity class * { *; }
-keep @androidx.room.Dao interface * { *; }

# Kotlinx Serialization
-keep class kotlinx.serialization.** { *; }
-keep @kotlinx.serialization.Serializable class * { *; }

# Coroutines
-keep class kotlinx.coroutines.** { *; }

# Compose
-keep class androidx.compose.** { *; }

# Accessibility Service
-keep class com.example.automation.service.AccessibilityServiceImpl { *; }

# MediaProjection
-keep class com.example.automation.service.MediaProjectionService { *; }

# Keep model classes
-keep class com.example.automation.core.model.** { *; }

# Keep executor classes
-keep class com.example.automation.core.executor.** { *; }
